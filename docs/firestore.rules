rules_version = '2';
// Regras de segurança do Firestore — versão revisada.
// Em relação a docs/firestore.rules: valida o esquema dos documentos, confere os e-mails
// com o token de autenticação, exige criadoEm do servidor e recusa presença em evento passado.
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }
    function tipoDoPerfil() {
      let ref = /databases/$(database)/documents/usuarios/$(request.auth.uid);
      return exists(ref) ? get(ref).data.tipo : '';
    }
    function ehAtletica() {
      return logado() && tipoDoPerfil() == 'atletica';
    }
    function ehEstudante() {
      return logado() && tipoDoPerfil() == 'estudante';
    }

    // Data "AAAA-MM-DD" como número AAAAMMDD, para comparar com a data do servidor.
    function dataComoNumero(d) {
      let p = d.split('-');
      return int(p[0]) * 10000 + int(p[1]) * 100 + int(p[2]);
    }
    // Ontem em UTC: folga para o fuso de Brasília (UTC-3) não barrar eventos de hoje à noite.
    function ontem() {
      let t = request.time - duration.value(1, 'd');
      return t.year() * 10000 + t.month() * 100 + t.day();
    }

    function eventoValido(d) {
      return d.keys().hasOnly(['nome', 'data', 'horario', 'local', 'tipo', 'descricao', 'atleticaId', 'atleticaEmail'])
        && d.keys().hasAll(['nome', 'data', 'tipo', 'atleticaId', 'atleticaEmail'])
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 100
        && d.data is string && d.data.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('horario' in d) || (d.horario is string && (d.horario == '' || d.horario.matches('^[0-2][0-9]:[0-5][0-9]$'))))
        && (!('local' in d) || (d.local is string && d.local.size() <= 120))
        && (!('descricao' in d) || (d.descricao is string && d.descricao.size() <= 1000))
        && d.tipo in ['esportivo', 'festa']
        && d.atleticaId == request.auth.uid
        && d.atleticaEmail == request.auth.token.email;
    }

    match /usuarios/{uid} {
      allow read: if logado() && request.auth.uid == uid;
      allow create: if logado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'tipo'])
        && request.resource.data.tipo in ['estudante', 'atletica']
        && request.resource.data.email == request.auth.token.email;
      allow update, delete: if false;
    }

    match /eventos/{id} {
      allow read: if logado();
      allow create: if ehAtletica() && eventoValido(request.resource.data);
      allow update: if ehAtletica()
        && resource.data.atleticaId == request.auth.uid
        && eventoValido(request.resource.data);
      allow delete: if ehAtletica() && resource.data.atleticaId == request.auth.uid;
    }

    // Confirmação de presença: um documento por estudante e evento (id = eventoId_uid).
    match /confirmacoes/{id} {
      allow read: if logado()
        && (resource.data.usuarioId == request.auth.uid
            || resource.data.atleticaId == request.auth.uid);
      allow create: if ehEstudante()
        && request.resource.data.keys().hasOnly(['eventoId', 'usuarioId', 'usuarioEmail', 'atleticaId', 'criadoEm'])
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.usuarioEmail == request.auth.token.email
        && request.resource.data.criadoEm == request.time
        && id == request.resource.data.eventoId + '_' + request.auth.uid
        && get(/databases/$(database)/documents/eventos/$(request.resource.data.eventoId)).data.atleticaId
           == request.resource.data.atleticaId
        && dataComoNumero(get(/databases/$(database)/documents/eventos/$(request.resource.data.eventoId)).data.data) >= ontem();
      allow update: if false;
      allow delete: if logado()
        && (resource.data.usuarioId == request.auth.uid
            || resource.data.atleticaId == request.auth.uid);
    }
  }
}
